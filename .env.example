# ============================================================
# Bitpin
# Public candle endpoint; API credentials are kept here for
# future authenticated/private Bitpin features.
# ============================================================
BITPIN_API_BASE_URL=https://api.bitpin.org
BITPIN_CANDLES_URL=https://api.bitpin.org/v1/mkt/tv/get_bars/

BITPIN_CANDLES_SYMBOL_PARAM=symbol
BITPIN_CANDLES_RESOLUTION_PARAM=res
BITPIN_CANDLES_FROM_PARAM=from
BITPIN_CANDLES_TO_PARAM=to

# Tether / Toman
BITPIN_SYMBOL=USDT_IRT
# 1 = 1-minute candles
BITPIN_RESOLUTION=1

# get_bars returns at most 10000 bars per request.
# At 1-minute resolution this is about 6.94 days.
BITPIN_MAX_BARS=10000
BITPIN_INITIAL_DAYS=7

BITPIN_API_KEY=
BITPIN_SECRET_KEY=

# ============================================================
# Wallex
# ============================================================
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_CANDLES_URL=https://api.wallex.ir/v1/udf/history
WALLEX_SYMBOL=USDTTMN
WALLEX_RESOLUTION=1
WALLEX_INITIAL_DAYS=20

# API key generated from Wallex dashboard. Sent as x-api-key.
WALLEX_API_KEY=

# ============================================================
# App refresh
# ============================================================
# 15 seconds = 4 requests/minute to our Next.js API route.
# The route makes one candle request per exchange per refresh.
CANDLE_REFRESH_MS=15000
NEXT_PUBLIC_CANDLE_REFRESH_MS=15000
