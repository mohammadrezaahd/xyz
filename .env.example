# --- Bitpin ---
BITPIN_API_BASE_URL=https://api.bitpin.ir
# Put the exact candle endpoint from Bitpin's current documentation here.
BITPIN_CANDLES_URL=https://api.bitpin.ir/v1/mkt/candles/
BITPIN_CANDLES_SYMBOL_PARAM=symbol
BITPIN_CANDLES_INTERVAL_PARAM=tf
BITPIN_CANDLES_LIMIT_PARAM=limit
BITPIN_SYMBOL=USDT_IRT
BITPIN_INTERVAL=1m
BITPIN_CANDLES_LIMIT=5000
BITPIN_API_KEY=
BITPIN_API_SECRET=

# --- Wallex ---
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_CANDLES_URL=https://api.wallex.ir/v1/udf/history
WALLEX_SYMBOL=USDTTMN
WALLEX_INTERVAL=1
WALLEX_INITIAL_DAYS=20
# Public UDF candles do not require this key.
WALLEX_API_KEY=

# Polling is deliberately far below documented/observed limits.
CANDLE_REFRESH_MS=15000
NEXT_PUBLIC_CANDLE_REFRESH_MS=15000
